# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.

# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=recruit
DB_PASS=change_me
DB_NAME=recruitment

# ─── IMAP (Gmail App Password) ───────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
IMAP_PASS=xxxx xxxx xxxx xxxx
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_MS=60000

# ─── CORS ────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5173

# ─── AI Provider ─────────────────────────────────────
AI_PROVIDER=gemini

# ─── Anthropic Claude ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Google Gemini ────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ─── Authentication ──────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=24h
